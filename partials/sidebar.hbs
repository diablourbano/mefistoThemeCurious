{{!-- The sidebar of the theme --}}
<div class="sidebar-overlay" aria-hidden="true"></div>
<div id="sidebar" class="sidebar" aria-hidden="true">
    <div class="sidebar-scroll">
        <div class="sidebar-inside">
            <div class="sidebar-top">
                <button
                    type="button"
                    class="sidebar-close button button-icon button-clear"
                    aria-label="{{t "Close Sidebar"}}"
                >
                    {{> "icons/close"}}
                </button>
            </div>
            <nav class="sidebar-menu" aria-labelledby="sidebar-menu-title">
                <h2 id="sidebar-menu-title" class="sidebar-menu-title">{{t "Explore {site_title}" site_title=@site.title}}</h2>
                {{!-- Includes the navigation menu - partials/navigation.hbs --}}
                {{navigation}}
                {{!-- If members enabled, shows member related menu items --}}
                {{#if @site.members_enabled}}
                    <ul class="actions">
                        {{!-- Not logged in: shows subscribe and sign in links --}}
                        {{#unless @member}}
                            <li class="action-item action-item-signup">
                                <button
                                    type="button"
                                    class="button button-clear"
                                    data-portal="signup"
                                >
                                    {{t "Subscribe"}}
                                </button>
                            </li>
                            <li class="action-item action-item-signin">
                                <button
                                    type="button"
                                    class="button button-clear"
                                    data-portal="signin"
                                >
                                    {{t "Sign in"}}
                                </button>
                            </li>
                        {{!-- Logged in: shows account link --}}
                        {{else}}
                            <li class="action-item action-item-account">
                                <button
                                    type="button"
                                    class="button button-clear"
                                    data-portal="account"
                                >
                                    {{t "Account"}}
                                </button>
                            </li>
                        {{/unless}}
                    </ul>
                {{/if}}
                {{!-- Includes the social links - partials/social-links.hbs --}}
                {{> social-links}}
            </nav>
        </div>
    </div>
</div>
